+// ---------------------------------------------------------------------------------------------
+// Per-role model provider selection.
+//
+// A role may name one provider id from the catalog the parent session already resolved
+// (configured `model_providers` merged with the built-in providers). The child config must always
+// carry a matching `model_provider_id` + `model_provider` pair, unresolvable ids must fail closed
+// without mutating the parent config, and a role must never be able to define or spoof a provider.
+// ---------------------------------------------------------------------------------------------
+
+/// Provider id registered in the parent catalog by the provider-selection tests.
+const CUSTOM_PROVIDER_ID: &str = "router";
+
+/// Mirrors how a user-configured (or router-managed) provider lands in `Config::model_providers`.
+fn custom_router_provider() -> ModelProviderInfo {
+    ModelProviderInfo {
+        name: "Router (custom)".to_string(),
+        base_url: Some("http://127.0.0.1:8123/v1".to_string()),
+        ..Default::default()
+    }
+}
+
+fn register_test_role(config: &mut Config, role_name: &str, role_path: PathBuf) {
+    config.agent_roles.insert(
+        role_name.to_string(),
+        AgentRoleConfig {
+            config_file: Some(role_path),
+            ..Default::default()
+        },
+    );
+}
+
+/// Reads a key from the role-projected session-flags layer, if that layer exists.
+fn role_layer_value(config: &Config, key: &str) -> Option<TomlValue> {
+    config
+        .config_layer_stack
+        .all_layers_low_to_high()
+        .rfind(|layer| layer.name == ConfigLayerSource::SessionFlags)
+        .and_then(|layer| layer.config.get(key).cloned())
+}
