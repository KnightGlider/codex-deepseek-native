+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn native_child_uses_role_provider_without_redirecting_parent() -> Result<()> {
+    let parent_server = start_mock_server().await;
+    let child_server = start_mock_server().await;
+    let spawn_args = serde_json::to_string(&json!({
+        "message": INITIAL_TASK,
+        "task_name": "worker",
+        "agent_type": ROLE_NAME,
+        "fork_turns": "none",
+    }))?;
+    mount_root_collaboration_call(
+        &parent_server,
+        INITIAL_PROMPT,
+        SPAWN_CALL_ID,
+        "spawn_agent",
+        &spawn_args,
+    )
+    .await;
+    let child_requests = mount_sse_once_match(
+        &child_server,
+        |request: &wiremock::Request| request_has_model(request, ROLE_MODEL),
+        sse(vec![
+            ev_response_created("custom-child-response"),
+            ev_assistant_message("custom-child-message", "custom provider completed"),
+            ev_completed("custom-child-response"),
+        ]),
+    )
+    .await;
+    let child_url = format!("{}/v1", child_server.uri());
+    let mut builder = test_codex().with_config(move |config| {
+        configure_multi_agent_v2_with_role(config, &child_url);
+        let mut provider = config.model_provider.clone();
+        provider.name = "Configured test provider".to_string();
+        provider.base_url = Some(child_url.clone());
+        provider.requires_openai_auth = false;
+        config
+            .model_providers
+            .insert("custom-test".to_string(), provider);
+        std::fs::write(
+            config.codex_home.join("durable-worker-role.toml"),
+            format!("model = {ROLE_MODEL:?}\nmodel_provider = \"custom-test\"\n"),
+        )
+        .expect("write provider-selecting role");
+    });
+    let test = builder.build_with_auto_env(&parent_server).await?;
+    let parent_provider = test.codex.config().await.model_provider.clone();
+    let parent_id = test.session_configured.thread_id;
+    test.codex
+        .start_or_steer_turn(
+            TurnInputRequest::user_input(vec![UserInput::Text {
+                text: INITIAL_PROMPT.to_string(),
+                text_elements: Vec::new(),
+            }])
+            .with_thread_settings(ThreadSettingsOverrides {
+                permission_profile: Some(PermissionProfile::Disabled),
+                ..Default::default()
+            }),
+        )
+        .await?;
+    let event = wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::ItemCompleted(event)
+            if matches!(&event.item, TurnItem::SubAgentActivity(item) if item.id == SPAWN_CALL_ID))
+    })
+    .await;
+    let EventMsg::ItemCompleted(spawned) = event else {
+        unreachable!("waited for native subagent activity");
+    };
+    assert_eq!(spawned.thread_id, parent_id);
+    let TurnItem::SubAgentActivity(activity) = spawned.item else {
+        unreachable!("waited for native subagent activity");
+    };
+    let child_id = activity.agent_thread_id;
+    let child = test.thread_manager.get_thread(child_id).await?;
+    wait_for_event(child.as_ref(), |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+
+    let request = child_requests.single_request().body_json();
+    assert_eq!(request["model"], json!(ROLE_MODEL));
+    assert_eq!(
+        request["client_metadata"]["x-codex-parent-thread-id"],
+        json!(parent_id)
+    );
+    assert_eq!(request["client_metadata"]["thread_id"], json!(child_id));
+    let child_config = child.config().await;
+    assert_eq!(child_config.model_provider_id, "custom-test");
+    assert_eq!(
+        child_config.model_provider.base_url,
+        Some(format!("{}/v1", child_server.uri()))
+    );
+    assert_eq!(test.codex.config().await.model_provider, parent_provider);
+    assert!(
+        parent_server
+            .received_requests()
+            .await
+            .expect("parent requests")
+            .iter()
+            .all(|request| !request_has_model(request, ROLE_MODEL))
+    );
+    child.shutdown_and_wait().await?;
+    Ok(())
+}
