+        .expect_err("retired provider id must fail");
+
+    assert!(
+        err.to_string()
+            .contains("`ollama-chat` is no longer supported")
+    );
+    assert_eq!(config.model_provider_id, "openai");
+}
+
+#[tokio::test]
+async fn gpt_and_custom_child_provider_snapshots_coexist() {
+    let (home, mut parent) = test_config_with_cli_overrides(Vec::new()).await;
+    let custom_provider = custom_router_provider();
+    parent
+        .model_providers
+        .insert(CUSTOM_PROVIDER_ID.to_string(), custom_provider.clone());
+    parent.model = Some("gpt-5.4-mini".to_string());
+    let parent_provider_id = parent.model_provider_id.clone();
+    let parent_provider = parent.model_provider.clone();
+
+    let native_role_path = write_role_config(
+        &home,
+        "native-child.toml",
+        "developer_instructions = \"Stay focused\"\nmodel = \"gpt-6-astra\"",
+    )
+    .await;
+    let router_role_path = write_role_config(
+        &home,
+        "router-child.toml",
+        "developer_instructions = \"Stay focused\"\nmodel = \"deepseek-v4-flash\"\nmodel_provider = \"router\"",
+    )
+    .await;
+
+    let mut native_child = parent.clone();
+    register_test_role(&mut native_child, "native-child", native_role_path);
+    let mut router_child = parent.clone();
+    register_test_role(&mut router_child, "router-child", router_role_path);
+
+    apply_role_to_config(&mut native_child, Some("native-child"))
+        .await
+        .expect("native child role should apply");
+    apply_role_to_config(&mut router_child, Some("router-child"))
+        .await
+        .expect("router child role should apply");
+
+    // The native child keeps the parent's GPT provider...
+    assert_eq!(native_child.model_provider_id, "openai");
+    assert_eq!(native_child.model_provider, parent_provider);
+    assert!(native_child.model_provider.is_openai());
+    assert_eq!(native_child.model.as_deref(), Some("gpt-6-astra"));
+
+    // ...while the router child is pinned to the configured provider, with both fields in sync.
+    assert_eq!(router_child.model_provider_id, CUSTOM_PROVIDER_ID);
+    assert_eq!(router_child.model_provider, custom_provider);
+    assert!(!router_child.model_provider.is_openai());
+    assert_eq!(router_child.model.as_deref(), Some("deepseek-v4-flash"));
+
+    // The two snapshots stay independent, and neither role leaked into the parent or its sibling.
+    assert_ne!(
+        native_child.model_provider_id,
+        router_child.model_provider_id
+    );
+    assert_ne!(native_child.model_provider, router_child.model_provider);
+    assert_eq!(native_child.model_providers, parent.model_providers);
+    assert_eq!(router_child.model_providers, parent.model_providers);
+    assert_eq!(native_child.model, Some("gpt-6-astra".to_string()));
+    assert_eq!(parent.model_provider_id, parent_provider_id);
+    assert_eq!(parent.model_provider, parent_provider);
+    assert_eq!(parent.model.as_deref(), Some("gpt-5.4-mini"));
+}
+
+#[tokio::test]
+async fn apply_role_selecting_current_provider_preserves_runtime_connection() {
+    let (home, mut config) = test_config_with_cli_overrides(Vec::new()).await;
+    config.model_provider.base_url = Some("http://127.0.0.1:43210/v1".to_string());
+    let role_path =
+        write_role_config(&home, "same-provider.toml", r#"model_provider = "openai""#).await;
+    register_test_role(&mut config, "custom", role_path);
+    let runtime_provider = config.model_provider.clone();
+    let catalog = config.model_providers.clone();
+
+    apply_role_to_config(&mut config, Some("custom"))
+        .await
+        .expect("selecting the current provider should preserve its runtime settings");
+
+    assert_eq!(config.model_provider_id, "openai");
+    assert_eq!(config.model_provider, runtime_provider);
+    assert_eq!(config.model_providers, catalog);
+}
