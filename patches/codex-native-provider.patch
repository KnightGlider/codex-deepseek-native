+#[tokio::test]
+async fn apply_role_selects_explicitly_configured_model_provider() {
+    let (home, mut config) = test_config_with_cli_overrides(Vec::new()).await;
+    let custom_provider = custom_router_provider();
+    config
+        .model_providers
+        .insert(CUSTOM_PROVIDER_ID.to_string(), custom_provider.clone());
+    let role_path = write_role_config(
+        &home,
+        "router-child.toml",
+        r#"developer_instructions = "Stay focused"
+model = "deepseek-v4-flash"
+model_provider = "router"
+"#,
+    )
+    .await;
+    register_test_role(&mut config, "custom", role_path);
+    let parent = config.clone();
+
+    apply_role_to_config(&mut config, Some("custom"))
+        .await
+        .expect("role with a configured provider should apply");
+
+    assert_eq!(config.model.as_deref(), Some("deepseek-v4-flash"));
+    assert_eq!(config.model_provider_id, CUSTOM_PROVIDER_ID);
+    assert_eq!(config.model_provider, custom_provider);
+    // Selecting an existing provider must not rewrite the provider catalog...
+    assert_eq!(config.model_providers, parent.model_providers);
+    // ...or any runtime permission surface.
+    assert_eq!(config.permissions, parent.permissions);
+    // The projected layer reports the same provider the child config now uses.
+    assert_eq!(
+        role_layer_value(&config, "model_provider"),
+        Some(TomlValue::String(CUSTOM_PROVIDER_ID.to_string()))
+    );
+}
